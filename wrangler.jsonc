{
  "$schema": "apps/api/node_modules/wrangler/config-schema.json",
  "name": "hedge-cms",
  // One Worker for the whole product: the API in apps/api, the admin SPA in apps/admin/dist.
  // The config lives at the repository root because that is where the Deploy to Cloudflare button
  // and Workers Builds look for it — a monorepo subdirectory would have to be self-contained,
  // and this one is not. Paths below are relative to this file.
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // The admin SPA is served straight from the edge. The Worker runs first for API and media
  // routes so a 404 there returns JSON instead of being rewritten to index.html.
  "assets": {
    "directory": "apps/admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // `/.well-known/*` is the Worker's too: OAuth discovery lives there, and the SPA fallback
    // would otherwise answer a metadata request with index.html.
    "run_worker_first": ["/api/*", "/media/*", "/.well-known/*"]
  },

  // The D1 database and R2 bucket carry no ids on purpose: Wrangler provisions whatever is
  // missing on the first `wrangler deploy` (and on the first `wrangler dev`, locally), then keeps
  // the Worker bound to it. That is what lets someone deploy this repository into their own
  // account without creating resources or editing this file first.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hedge-db",
      "migrations_dir": "apps/api/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hedge-media"
    }
  ],

  // Cloudflare Email Sending. Deploying works without it, but nothing sends until the `from`
  // domain is onboarded:
  //   bunx wrangler email sending enable yourdomain.com
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "Hedge",
    // Left empty deliberately. A deployment does not know its own URL until it has one — a
    // one-click deploy gets a generated workers.dev subdomain — so the Worker falls back to the
    // origin of the request it is answering. Set this once the deployment has a custom domain,
    // and invite links, media URLs and the OAuth resource identifier follow it.
    // It must be a full origin with the scheme, `https://cms.example.com` and no trailing slash.
    // Better Auth is constructed from it and rejects anything that isn't a URL, which takes down
    // every authenticated route while /api/health carries on answering ok.
    "PUBLIC_URL": "",
    // The system sender, for the whole deployment rather than per site: invites, password resets,
    // member sign-in links and every site's newsletters all leave from this address. Overridable
    // in the admin under Settings → Email, which is the easier place to change it after the fact.
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": "Hedge CMS",
    // The repository this deployment was created from. Left empty: the update notice works without
    // it (it links to the upstream release notes), and with it the admin can deep-link the
    // repository. It changes nothing about how the Worker runs.
    "REPO_URL": "",
    // How the deployment was installed — `button`, `installer` or `cli` — so the About page offers
    // the update path that actually exists for it. A deploy-button setup page prompts for this; the
    // installer sets it itself. Empty is safe and true for anything that predates it: the admin
    // then shows the dashboard update *and* the git fallback, claiming no repository relationship.
    // Display only. Nothing about how the Worker runs reads it. See issue #39.
    "INSTALLED_BY": "",
    // The Cloudflare script name, when it is not the `name` at the top of this file. A Worker is
    // not told its own script name at run time and the dashboard updater has to address itself, so
    // the installer — which lets the operator name the deployment — records the name here. Leave
    // empty for a button or CLI deploy: those are always `hedge-cms`.
    "WORKER_NAME": ""
  }

  // AUTH_SECRET is the only secret. Locally it goes in `.dev.vars`; in a deployment it is set
  // with `wrangler secret put AUTH_SECRET`, or typed into the Deploy to Cloudflare setup page.
}
