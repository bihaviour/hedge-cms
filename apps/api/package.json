{
  "name": "@hedge/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply hedge-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hedge-db --remote --env production",
    "db:seed": "wrangler d1 execute hedge-db --local --file=./seeds/dev.sql",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@hedge/core": "workspace:*",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
