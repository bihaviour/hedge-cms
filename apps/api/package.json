{
  "name": "@hedge/api",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc --var ENVIRONMENT:development",
    "build": "wrangler deploy --config ../../wrangler.jsonc --dry-run --outdir dist",
    "deploy": "bun ../../scripts/deploy-worker.ts",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --config ../../wrangler.jsonc --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --config ../../wrangler.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --config ../../wrangler.jsonc --remote",
    "db:seed": "wrangler d1 execute DB --config ../../wrangler.jsonc --local --file=./seeds/dev.sql",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@hedge/core": "workspace:*",
    "@hedge/deploy": "workspace:*",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
